# 팡슐랭 운영 환경 변수 템플릿 (EC2 + RDS 프리티어 시나리오)
#
# 사용법:
#   1. 이 파일을 .env.production 으로 복사
#        cp .env.production.example .env.production
#   2. < ... > 형태의 placeholder 를 실제 값으로 채움
#   3. EC2 의 /opt/pangchelin/.env.production 으로 두고 권한 660 으로 잠금
#        sudo chown ubuntu:docker .env.production && sudo chmod 660 .env.production
#   4. 절대 git 에 커밋하지 말 것 (.gitignore 에 이미 등록됨)

# ─── DB (RDS 사용 시) ──────────────────────────────────────
# AWS RDS PostgreSQL db.t3.micro 프리티어 (12개월 무료, 750h/월, 20GB)
# 엔드포인트: AWS 콘솔 > RDS > 데이터베이스 > 연결 & 보안 탭 참고
DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>:5432/pangchelin?schema=public

# ─── DB (self-hosted 모드 시 — EC2 컨테이너 안의 postgres) ──
# docker compose 실행 시 --profile self-hosted-db 를 붙이면 활성화됨.
# 이 경우 DATABASE_URL 은 아래처럼 컨테이너 이름으로 작성:
#   DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public
POSTGRES_USER=pangchelin
POSTGRES_PASSWORD=<강력 랜덤 32자+>
POSTGRES_DB=pangchelin

# ─── 인증 ──────────────────────────────────────────────────
# 32 자 이상 랜덤 문자열. 한 번 정하면 변경 시 모든 토큰 무효화됨.
# 생성: openssl rand -base64 48
JWT_SECRET=<32자 이상 강력 랜덤>

# ─── 프론트엔드 빌드 인자 (NEXT_PUBLIC_*) ────────────────────
# 빌드 시점에 인라인 — 변경 시 web 이미지 재빌드 필요.
#
# PUBLIC_API_URL:
#   - Nginx 리버스 프록시 사용 시: https://<도메인>/api
#   - Nginx 없이 직접 노출 시:     http://<EC2 퍼블릭 IP>:4000
PUBLIC_API_URL=https://<도메인>/api

# 카카오맵 JS SDK 키 (카카오 개발자 콘솔에서 발급, 도메인 등록 필수)
# developers.kakao.com > 내 애플리케이션 > 플랫폼 > Web 사이트 도메인에 운영 도메인 추가
KAKAO_MAP_KEY=<kakao-js-key>

# ─── CORS (API 가 허용할 프론트 도메인) ────────────────────
# 쉼표로 여러 origin 허용 가능
CORS_ORIGIN=https://<도메인>

# ─── 이미지 업로드 (선택사항) ──────────────────────────────
# S3 안 쓰면 비워둠 — 식당 대표사진을 apps/web/public/restaurants/ 번들 그대로 사용.
# 사용자 업로드 기능을 켜려면 IAM 사용자 발급 후 채움.
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
